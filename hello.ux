<template>
  <div class="container">
    <text class="title">ПЯТНАШКИ</text>
    
    <!-- Игровое поле 3х3 -->
    <div class="grid">
      <block for="(index, value) in board">
        <div 
          class="tile {{value === 0 ? 'empty' : ''}}" 
          onclick="moveTile(index)">
          <text class="tile-text">{{value === 0 ? '' : value}}</text>
        </div>
      </block>
    </div>

    <!-- Кнопка Новая игра -->
    <input class="btn" type="button" value="Заново" onclick="resetGame" />
  </div>
</template>

<script>
  import device from '@system.device'

  export default {
    private: {
      board: [1, 2, 3, 4, 5, 6, 7, 8, 0]
    },
    onInit() {
      this.resetGame();
    },
    resetGame() {
      let mixed;
      do {
        mixed = [...this.board].sort(() => Math.random() - 0.5);
      } while (!this.isSolvable(mixed) || this.isVictory(mixed)); 
      
      this.board = mixed;
    },
    moveTile(index) {
      const emptyIndex = this.board.indexOf(0);
      
      const tileRow = Math.floor(index / 3);
      const tileCol = index % 3;
      const emptyRow = Math.floor(emptyIndex / 3);
      const emptyCol = emptyIndex % 3;

      const isNeighbor = (Math.abs(tileRow - emptyRow) + Math.abs(tileCol - emptyCol)) === 1;

      if (isNeighbor) {
        const newBoard = [...this.board];
        newBoard[emptyIndex] = this.board[index];
        newBoard[index] = 0;
        this.board = newBoard;

        if (this.isVictory(this.board)) {
          this.triggerVibration();
        }
      }
    },
    isVictory(currentBoard) {
      const winPattern =;
      return currentBoard.every((val, i) => val === winPattern[i]);
    },
    isSolvable(arr) {
      let inversions = 0;
      for (let i = 0; i < arr.length - 1; i++) {
        for (let j = i + 1; j < arr.length; j++) {
          if (arr[i] > arr[j] && arr[i] !== 0 && arr[j] !== 0) {
            inversions++;
          }
        }
      }
      return inversions % 2 === 0;
    },
    triggerVibration() {
      device.vibrate({
        mode: 'short'
      });
    }
  }
</script>

<style>
  .container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
    padding: 10px;
  }
  .title {
    color: #ffffff;
    font-size: 20px;
    margin-bottom: 15px;
    font-weight: bold;
  }
  .grid {
    flex-wrap: wrap;
    width: 180px;
    height: 180px;
    justify-content: center;
    align-content: center;
  }
  .tile {
    width: 54px;
    height: 54px;
    margin: 3px;
    background-color: #2196F3;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
  }
  .empty {
    background-color: #1c1c1e;
  }
  .tile-text {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
  }
  .btn {
    margin-top: 25px;
    width: 140px;
    height: 40px;
    background-color: #4CAF50;
    color: #ffffff;
    border-radius: 20px;
    font-size: 16px;
  }
</style>
